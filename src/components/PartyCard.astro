---
/**
 * Partikort för partiöversikten. Samma layout för alla partier.
 * "Granskade ämnen" beskriver dokumentationsläget — inte politikens kvalitet.
 */
import type { CollectionEntry } from "astro:content";
import PartyMark from "./PartyMark.astro";
import { GOVERNMENT_STATUS_LABELS } from "@/lib/evidence";
import { formatDate } from "@/lib/format";

interface Props {
  party: CollectionEntry<"parties">;
  reviewedCount: number;
  totalTopics: number;
  noPositionCount: number;
}
const { party, reviewedCount, totalTopics, noPositionCount } = Astro.props;
const p = party.data;
---

<a
  href={`/partier/${party.id}/`}
  class="group block border border-border bg-card p-6 transition-colors hover:border-foreground"
>
  <div class="flex items-start justify-between gap-4">
    <PartyMark abbreviation={p.abbreviation} color={p.color} size="md" />
    <span class="bi-mono">{GOVERNMENT_STATUS_LABELS[p.governmentStatus]}</span>
  </div>
  <h2 class="mt-4 text-xl leading-snug">{p.name}</h2>
  <p class="mt-2 text-sm text-muted-foreground">
    {p.aiSummary ?? "Partiets AI-hållning är ännu inte granskad i researcharbetet."}
  </p>
  {
    p.aiPriorities.length > 0 && (
      <div class="mt-4">
        <div class="bi-mono !text-[10px] mb-1.5">Dokumenterade prioriteringar</div>
        <ul class="space-y-1 text-sm text-muted-foreground">
          {p.aiPriorities.slice(0, 3).map((priority) => (
            <li class="flex gap-2">
              <span aria-hidden="true">·</span>
              {priority}
            </li>
          ))}
        </ul>
      </div>
    )
  }
  <div class="mt-4 border-t border-border pt-3 flex flex-wrap items-center gap-x-4 gap-y-1">
    <span class="bi-mono !text-[10px]">
      Dokumentationsläge: {reviewedCount} av {totalTopics} ämnen granskade
    </span>
    {
      noPositionCount > 0 && (
        <span class="bi-mono !text-[10px]">
          {noPositionCount} utan dokumenterad ståndpunkt
        </span>
      )
    }
  </div>
  <div class="mt-2 bi-mono !text-[10px]">
    {p.lastReviewedAt ? `Senast granskad ${formatDate(p.lastReviewedAt)}` : "Ännu ej granskad"}
  </div>
</a>
