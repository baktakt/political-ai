---
/**
 * Väljarnära partikort med partifärg och kort väg till partisidan.
 */
import type { CollectionEntry } from "astro:content";
import PartyMark from "./PartyMark.astro";


interface Props {
  party: CollectionEntry<"parties">;
}
const { party } = Astro.props;
const p = party.data;
const conciseSummary = p.aiSummary
  ?.split(/(?<=[.!?])\s+/)
  .slice(0, 1)
  .join(" ");
---

<a
  href={`/partier/${party.id}/`}
  class:list={[
    "group relative flex h-full flex-col overflow-hidden border border-border bg-card p-5 transition-all hover:-translate-y-0.5 hover:border-foreground hover:shadow-md",
    conciseSummary ? "min-h-52" : "min-h-32",
  ]}
  style={`--party-color:${p.color}`}
>
  <span class="absolute inset-x-0 top-0 h-1" style="background:var(--party-color)" aria-hidden="true"></span>
  <div class="flex items-start justify-between gap-4">
    <PartyMark abbreviation={p.abbreviation} color={p.color} size="logo" />
    <span class="bi-mono !text-[10px] transition-transform group-hover:translate-x-0.5">Läs om partiet →</span>
  </div>

  <h2 class="mt-4 text-xl leading-snug">{p.name}</h2>

  {
    conciseSummary ? (
      <p class="mt-2 max-w-md text-sm leading-relaxed text-muted-foreground">{conciseSummary}</p>
    ) : null
  }

  {
    conciseSummary && p.aiPriorities.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {p.aiPriorities.slice(0, 2).map((priority) => (
          <span class="rounded-full bg-muted px-2.5 py-1 text-xs text-muted-foreground">{priority}</span>
        ))}
      </div>
    )
  }
</a>
