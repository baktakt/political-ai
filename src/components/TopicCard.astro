---
/** Ämneskort för ämnesöversikten. */
import type { CollectionEntry } from "astro:content";

interface Props {
  topic: CollectionEntry<"topics">;
  positionCount: number;
  partyCount: number;
}
const { topic, positionCount, partyCount } = Astro.props;
const t = topic.data;
---

<a
  href={`/amnen/${topic.id}/`}
  class="group block border border-border bg-card p-6 transition-colors hover:border-foreground"
>
  <div class="flex items-start justify-between gap-4">
    <span
      class="bi-mono !text-[10px]"
      style={t.group === "hallbarhet" ? "color:var(--moss)" : undefined}
    >
      {t.group === "hallbarhet" ? "AI & hållbarhet" : "AI i samhället"}
    </span>
    <span class="bi-mono !text-[10px]">
      {positionCount} av {partyCount} partier granskade
    </span>
  </div>
  <h3 class="mt-3 text-lg leading-snug">{t.title}</h3>
  <p class="mt-2 text-sm text-muted-foreground">{t.description}</p>
</a>
