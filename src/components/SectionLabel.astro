---
/**
 * Sektionsrubrik med kicker — porterad från BI:s SectionLabel (samma
 * klassrecept). Astro-version med slot i stället för React-prop för
 * höger-innehåll.
 */
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<div class="flex flex-wrap items-end justify-between gap-4 border-t border-border pt-6">
  <div class="max-w-2xl">
    {eyebrow && <div class="bi-mono mb-2">{eyebrow}</div>}
    <h2 class="text-2xl md:text-3xl leading-tight">{title}</h2>
    {description && <p class="mt-2 text-sm text-muted-foreground">{description}</p>}
  </div>
  <slot name="right" />
</div>
