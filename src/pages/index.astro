---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NeutralityNote from "@/components/NeutralityNote.astro";
import PartyMark from "@/components/PartyMark.astro";
import QuestionTeaser from "@/components/QuestionTeaser.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import { getPartiesSorted, getMeta } from "@/lib/content";

import { getSiteOverviewMetrics } from "@/lib/site-overview";
import { getCollection } from "astro:content";
import { formatDate } from "@/lib/format";
import proposalRecords from "@/data/proposals.json";
import actionRecords from "@/data/actions.json";
import sourceRecords from "@/data/sources.json";

const parties = await getPartiesSorted();
const meta = await getMeta();
const questions = (await getCollection("questions"))
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder)
  .slice(0, 4);
const metrics = getSiteOverviewMetrics({
  parties: parties.map((party) => party.data),
  proposals: proposalRecords,
  actions: actionRecords,
  sources: sourceRecords,
});
---

<BaseLayout
  title="Vad vill partierna med AI?"
  description="En enkel och källbaserad överblick över hur Sveriges riksdagspartier närmar sig artificiell intelligens."
>
  <div class="mx-auto max-w-7xl px-6">
    <!-- Hero -->
    <section class="border-b border-border py-14 md:py-20">
      <div class="bi-mono">Inför riksdagsvalet 2026 · partipolitiskt neutral</div>
      <h1 class="mt-4 max-w-4xl text-4xl leading-tight md:text-6xl">
        Vad vill Sveriges partier ha för AI-politik?
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground md:text-lg">
        Den här webbplatsen är ett försök att göra det enklare att se hur Sveriges största
        partier ställer sig till AI. Klicka på varje parti för att läsa mer. All kod, data och
        källmaterial är öppet tillgängligt på{" "}
        <a
          href="https://github.com/baktakt/political-ai"
          target="_blank"
          rel="noopener noreferrer"
          class="border-b border-foreground pb-px text-foreground hover:opacity-70"
        >GitHub</a>.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href="/partier/"
          class="inline-flex items-center border border-foreground bg-foreground px-5 py-2.5 text-xs uppercase tracking-wide text-background transition-colors hover:bg-transparent hover:text-foreground"
        >
          Se partiernas AI-politik
        </a>
        <a
          href="/jamfor/"
          class="inline-flex items-center border border-foreground px-5 py-2.5 text-xs uppercase tracking-wide transition-colors hover:bg-foreground hover:text-background"
        >
          Jämför partier
        </a>
      </div>
      <div class="mt-5 bi-mono">
        Senast genomgånget {formatDate(meta.researchLastUpdated)}
        {meta.pilot && " · pilotversion"}
      </div>
    </section>

    <!-- Primär ingång: partier -->
    <section class="py-12">
      <SectionLabel
        eyebrow="Börja här"
        title="Välj ett parti"
        description="Partierna visas i bokstavsordning."
      >
        <a slot="right" href="/partier/" class="border-b border-foreground pb-0.5 text-sm hover:opacity-70">
          Se hela översikten
        </a>
      </SectionLabel>

      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          parties.map((party) => {
            const teaser = party.data.aiSummary?.split(/(?<=[.!?])\s+/)[0];
            return (
              <li>
                <a
                  href={`/partier/${party.id}/`}
                  class="group relative flex h-full min-h-36 flex-col overflow-hidden border border-border bg-card p-5 transition-all hover:-translate-y-0.5 hover:border-foreground hover:shadow-md"
                  style={`--party-color:${party.data.color}`}
                >
                  <span class="absolute inset-x-0 top-0 h-1" style="background:var(--party-color)" aria-hidden="true"></span>
                  <div class="flex items-center justify-between gap-3">
                    <PartyMark
                      abbreviation={party.data.abbreviation}
                      color={party.data.color}
                      size="logo"
                    />
                    <span class="bi-mono !text-[9px] transition-transform group-hover:translate-x-0.5">Läs om partiet →</span>
                  </div>
                  <h2 class="mt-3 text-lg leading-snug group-hover:underline underline-offset-4">
                    {party.data.name}
                  </h2>
                  {teaser && <span class="mt-2 text-xs leading-relaxed text-muted-foreground">{teaser}</span>}
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    <!-- Överblick över publicerat underlag -->
    <section class="border-y border-border py-10 md:py-12">
      <SectionLabel
        eyebrow="Det vi har gått igenom"
        title="Underlaget just nu"
        description="En överblick över det som är publicerat och källbelagt på sajten. Siffrorna är inte en rankning av partierna."
      />

      <div class="mt-6 grid gap-4 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
        <div class="border border-border bg-muted/45 p-5 sm:p-6">
          <div class="flex items-start justify-between gap-5">
            <div>
              <p class="bi-mono !text-[10px] text-[var(--steel)]">PARTISAMMANFATTNINGAR</p>
              <h3 class="mt-2 font-display text-2xl leading-tight sm:text-3xl">
                {metrics.documentedOverviewCount} av {metrics.partyCount} partier
              </h3>
              <p class="mt-2 max-w-md text-sm leading-relaxed text-muted-foreground">
                har en publicerad sammanfattning av sin AI-politik.
              </p>
            </div>
            <span class="shrink-0 border border-[var(--steel)] px-2.5 py-1 font-mono text-xs text-[var(--steel)]">
              {metrics.documentedOverviewCount}/{metrics.partyCount}
            </span>
          </div>
          <div
            class="mt-5 flex gap-1.5"
            role="img"
            aria-label={`${metrics.documentedOverviewCount} av ${metrics.partyCount} partier har en sammanfattning av sin syn på AI.`}
          >
            {
              Array.from({ length: metrics.partyCount }, (_, index) => (
                <span
                  aria-hidden="true"
                  class:list={[
                    "h-2 flex-1 border border-[var(--steel)]",
                    index < metrics.documentedOverviewCount ? "bg-[var(--steel)]" : "bg-transparent",
                  ]}
                />
              ))
            }
          </div>
          <p class="mt-5 border-t border-border pt-4 text-xs leading-relaxed text-muted-foreground">
            Sammanfattningarna beskriver huvuddragen i materialet vi har gått igenom. Öppna en partisida för förslag, källor och svar fråga för fråga.
          </p>
        </div>

        <div class="border border-border bg-card">
          <dl class="grid grid-cols-3 divide-x divide-border">
            <div class="p-4 sm:p-5">
              <dt class="text-xs leading-snug text-muted-foreground">Förslag</dt>
              <dd class="mt-2 font-display text-3xl tabular-nums">{metrics.publishedProposalCount}</dd>
              <p class="mt-1 text-[11px] leading-snug text-muted-foreground">publicerade</p>
            </div>
            <div class="p-4 sm:p-5">
              <dt class="text-xs leading-snug text-muted-foreground">Aktiviteter</dt>
              <dd class="mt-2 font-display text-3xl tabular-nums">{metrics.publishedActionCount}</dd>
              <p class="mt-1 text-[11px] leading-snug text-muted-foreground">i riksdagen</p>
            </div>
            <div class="p-4 sm:p-5">
              <dt class="text-xs leading-snug text-muted-foreground">Källor</dt>
              <dd class="mt-2 font-display text-3xl tabular-nums">{metrics.sourceCount}</dd>
              <p class="mt-1 text-[11px] leading-snug text-muted-foreground">öppnade</p>
            </div>
          </dl>
          <p class="border-t border-border px-4 py-4 text-xs leading-relaxed text-muted-foreground sm:px-5">
            Omfattningen skiljer sig mellan partierna. Därför visar vi inte en jämförande graf som kan misstolkas som en aktivitetsrankning.
          </p>
        </div>
      </div>
    </section>

    <!-- Väljarfrågor -->
    <section class="py-12">
      <SectionLabel
        eyebrow="Eller börja i en sakfråga"
        title="Vad undrar du om AI?"
        description="Fyra vanliga väljarfrågor. Svaren bygger på samma källor som partisidorna."
      >
        <a slot="right" href="/fragor/" class="border-b border-foreground pb-0.5 text-sm hover:opacity-70">
          Alla frågor
        </a>
      </SectionLabel>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {questions.map((question) => <QuestionTeaser question={question} />)}
      </div>
    </section>

    <!-- Transparens, komprimerad -->
    <section class="pb-16 pt-4">
      <div class="grid gap-5 border-t border-border pt-8 lg:grid-cols-[1fr_auto] lg:items-start">
        <div class="max-w-2xl">
          <h2 class="text-xl">Källor före slutsatser</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            Sajten rangordnar inte partierna och fyller inte i luckor utifrån ideologi.
            Regeringspolitik, enskilda uttalanden och partiets egen linje hålls isär.
          </p>
        </div>
        <nav aria-label="Om sajten" class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
          <a href="/metod/" class="border-b border-border pb-0.5 hover:border-foreground">Metod</a>
          <a href="/kallor/" class="border-b border-border pb-0.5 hover:border-foreground">Källor</a>
          <a href="/korrigeringar/" class="border-b border-border pb-0.5 hover:border-foreground">Korrigeringar</a>
        </nav>
      </div>
      <div class="mt-6 max-w-3xl">
        <NeutralityNote />
      </div>
    </section>
  </div>
</BaseLayout>
