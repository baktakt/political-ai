---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import { getCollection } from "astro:content";
import { getTopicsSorted } from "@/lib/content";
import { WATCH_PUBLISHER_TYPE_LABELS } from "@/lib/evidence";
import { formatDate, hostFromUrl } from "@/lib/format";

const reports = (await getCollection("omvarldsbevakning"))
  .filter((r) => r.data.workflowStatus === "publicerad")
  .sort((a, b) => b.data.publicationDate.localeCompare(a.data.publicationDate));

const topics = await getTopicsSorted();
const topicsById = new Map(topics.map((t) => [t.id, t]));

const languageLabels: Record<string, string> = {
  en: "engelska",
  sv: "svenska",
  de: "tyska",
  fr: "franska",
};
---

<BaseLayout
  title="Omvärldsbevakning"
  description="Internationella rapporter om AI-utvecklingen från verifierade källor, sammanfattade på svenska."
>
  <div class="mx-auto max-w-7xl px-6" data-pagefind-body data-pagefind-filter="Typ:Omvärldsbevakning">
    <header class="border-b border-border py-10">
      <div class="bi-mono">Internationell utblick · {reports.length} {reports.length === 1 ? "rapport" : "rapporter"}</div>
      <h1 class="mt-3 text-3xl md:text-4xl leading-tight">Omvärldsbevakning</h1>
      <p class="mt-3 max-w-2xl text-base text-muted-foreground">
        AI-politiken formas inte bara i Sverige. På den här sidan finns
        internationella rapporter om AI-utvecklingen på svenska, med länkar
        till originalen. Punkterna är rapporternas egna
        huvudslutsatser i svensk översättning, inte webbplatsens
        ställningstaganden.
      </p>
    </header>

    <section class="py-8">
      <div class="max-w-2xl border border-border bg-muted/50 px-4 py-3 text-sm text-muted-foreground">
        <span class="bi-mono !text-[10px] block mb-1">Källkriterier</span>
        Endast verifierade utgivare: etablerade forskningsinstitutioner,
        internationella organisationer, myndigheter, EU-institutioner,
        regeringar och namnkunniga tankesmedjor. Inga anonyma bloggar,
        overifierade konton eller AI-genererade sammanfattningar som källor.
        Samma princip gäller i <a href="/metod/" class="border-b border-border pb-px hover:text-foreground">metodiken</a> i övrigt.
      </div>
    </section>

    <section class="pb-16 space-y-6">
      {
        reports.map((report) => {
          const r = report.data;
          const relatedTopics = r.relatedTopicIds
            .map((id) => topicsById.get(id))
            .filter((t) => t != null);
          return (
            <article class="border border-border bg-card p-6" id={report.id}>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
                <span class="bi-mono !text-[10px]">
                  {WATCH_PUBLISHER_TYPE_LABELS[r.publisherType]}
                </span>
                <span aria-hidden="true">·</span>
                <span>{formatDate(r.publicationDate)}</span>
                <span aria-hidden="true">·</span>
                <span>på {languageLabels[r.language] ?? r.language}</span>
              </div>
              <h2 class="mt-3 font-display text-2xl leading-snug">
                <a
                  href={r.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:underline underline-offset-4"
                >
                  {r.title}
                </a>
              </h2>
              <p class="mt-1 text-sm text-muted-foreground">{r.publisher}</p>
              <p class="mt-4 max-w-3xl text-sm leading-relaxed">{r.summary}</p>

              <div class="mt-5">
                <h3 class="bi-mono !text-[10px] mb-2">
                  Rapportens huvudslutsatser (svensk översättning)
                </h3>
                <ul class="max-w-3xl space-y-2">
                  {r.keyTakeaways.map((takeaway) => (
                    <li class="flex gap-3 text-sm leading-relaxed text-muted-foreground">
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-foreground" aria-hidden="true" />
                      {takeaway}
                    </li>
                  ))}
                </ul>
              </div>

              {relatedTopics.length > 0 && (
                <div class="mt-5 flex flex-wrap items-center gap-2">
                  <span class="bi-mono !text-[10px]">Relaterade ämnen</span>
                  {relatedTopics.map((t) => (
                    <a
                      href={`/amnen/${t.id}/`}
                      class="border border-border px-2 py-0.5 text-[11px] text-muted-foreground hover:border-foreground hover:text-foreground transition-colors"
                    >
                      {t.data.shortTitle}
                    </a>
                  ))}
                </div>
              )}

              <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-border pt-4">
                <a
                  href={r.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-2 border-b border-foreground pb-0.5 text-sm text-foreground hover:opacity-70"
                >
                  Öppna originalrapporten
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 12 12"
                    aria-hidden="true"
                    class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  >
                    <path d="M3 3h6v6M9 3L3 9" fill="none" stroke="currentColor" stroke-width="1.2" />
                  </svg>
                </a>
                <span class="bi-mono !text-[10px]">
                  {hostFromUrl(r.url)} · hämtad {formatDate(r.accessedAt)}
                </span>
              </div>
            </article>
          );
        })
      }
      {
        reports.length === 0 && (
          <p class="max-w-2xl border border-dashed border-border p-4 text-sm text-muted-foreground">
            Inga rapporter är publicerade ännu.
          </p>
        )
      }
    </section>
  </div>
</BaseLayout>
