---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Sidan hittades inte">
  <div class="mx-auto max-w-7xl px-6">
    <div class="py-24 text-center">
      <div class="bi-mono">Fel 404</div>
      <h1 class="mt-3 text-3xl md:text-4xl">Sidan hittades inte</h1>
      <p class="mx-auto mt-3 max-w-md text-base text-muted-foreground">
        Sidan kan ha flyttats eller aldrig ha funnits. Prova att
        <a href="/sok/" class="underline underline-offset-4">söka</a> eller gå
        till <a href="/" class="underline underline-offset-4">startsidan</a>.
      </p>
    </div>
  </div>
</BaseLayout>
