---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import { getCollection } from "astro:content";
import { SITE } from "@/data/site";
import { formatDate } from "@/lib/format";

const corrections = (await getCollection("corrections")).sort((a, b) =>
  b.data.submittedAt.localeCompare(a.data.submittedAt),
);
const statusLabels: Record<string, string> = {
  mottagen: "Mottagen",
  under_granskning: "Under granskning",
  atgardad: "Åtgärdad",
  avvisad: "Avvisad",
};
const issueBase = `${SITE.repoUrl}/issues/new`;
---

<BaseLayout
  title="Korrigeringar"
  description="Öppen korrigeringspolicy: rapportera fel, följ rättelser och se hur vi hanterar felaktigheter."
>
  <div class="mx-auto max-w-7xl px-6" data-pagefind-body>
    <header class="border-b border-border py-10">
      <div class="bi-mono">Transparens</div>
      <h1 class="mt-3 text-3xl md:text-4xl leading-tight">Korrigeringar</h1>
      <p class="mt-3 max-w-2xl text-base text-muted-foreground">
        Fel ska hittas och rättas — öppet. Här kan du rapportera fel, och här
        redovisas alla rättelser som gjorts.
      </p>
    </header>

    <div class="pol-prose py-10">
      <h2>Vår korrigeringspolicy</h2>
      <ul>
        <li>Alla felanmälningar granskas mot originalkällorna.</li>
        <li>Bekräftade sakfel rättas snarast, och rättelsen loggas öppet nedan och i <a href="/uppdateringar/">uppdateringsloggen</a>.</li>
        <li>Om ett fel kan ha påverkat bilden av ett parti anges det uttryckligen i rättelsen.</li>
        <li>Avvisade anmälningar redovisas också, med motivering.</li>
      </ul>
    </div>

    <section class="max-w-3xl">
      <SectionLabel eyebrow="Formulär" title="Rapportera ett fel" />
      <form
        id="korrigeringsformular"
        class="mt-6 space-y-5 border border-border bg-card p-6"
      >
        <div>
          <label for="sida" class="block text-sm font-medium">Vilken sida gäller det?</label>
          <input
            type="text"
            id="sida"
            name="sida"
            placeholder="/partier/s/ eller en webbadress"
            class="mt-1.5 w-full border border-input bg-background px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label for="beskrivning" class="block text-sm font-medium">
            Beskriv felet <span class="text-muted-foreground">(obligatoriskt)</span>
          </label>
          <textarea
            id="beskrivning"
            name="beskrivning"
            required
            rows="5"
            placeholder="Vad är fel, och vad borde det stå? Länka gärna till en källa."
            class="mt-1.5 w-full border border-input bg-background px-3 py-2 text-sm"></textarea>
          <p id="beskrivning-fel" class="mt-1 hidden text-sm" role="alert">
            <strong>Beskrivning saknas:</strong> beskriv felet innan du skickar.
          </p>
        </div>
        <p class="text-xs text-muted-foreground">
          Anmälan skickas som ett öppet ärende i webbplatsens GitHub-arkiv (kräver
          GitHub-konto). Skicka inte med känsliga personuppgifter — och aldrig
          uppgifter om politiska åsikter.
        </p>
        <button
          type="submit"
          class="border border-foreground bg-foreground px-4 py-2 text-xs uppercase tracking-wide text-background hover:bg-transparent hover:text-foreground transition-colors"
        >
          Öppna ärende på GitHub
        </button>
        <noscript>
          <p class="text-sm">
            Formuläret kräver JavaScript. Du kan i stället
            <a href={`${issueBase}?title=Korrigering`} class="underline underline-offset-4" target="_blank" rel="noopener noreferrer">öppna ett ärende direkt på GitHub</a>.
          </p>
        </noscript>
      </form>
      <script define:vars={{ issueBase }}>
        const form = document.getElementById("korrigeringsformular");
        const params = new URLSearchParams(window.location.search);
        const sidaField = document.getElementById("sida");
        const prefill = params.get("sida");
        if (prefill && sidaField) sidaField.value = prefill;
        form?.addEventListener("submit", (event) => {
          event.preventDefault();
          const beskrivning = document.getElementById("beskrivning");
          const felmeddelande = document.getElementById("beskrivning-fel");
          if (!beskrivning.value.trim()) {
            felmeddelande.classList.remove("hidden");
            beskrivning.setAttribute("aria-invalid", "true");
            beskrivning.focus();
            return;
          }
          felmeddelande.classList.add("hidden");
          beskrivning.removeAttribute("aria-invalid");
          const sida = sidaField.value.trim();
          const title = encodeURIComponent(
            `Korrigering: ${sida || "(sida ej angiven)"}`,
          );
          const body = encodeURIComponent(
            `**Sida:** ${sida || "ej angiven"}\n\n**Beskrivning av felet:**\n${beskrivning.value.trim()}\n\n*Anmäld via korrigeringsformuläret.*`,
          );
          window.open(
            `${issueBase}?title=${title}&body=${body}`,
            "_blank",
            "noopener",
          );
        });
      </script>
    </section>

    <section class="py-12">
      <SectionLabel
        eyebrow="Öppen logg"
        title="Genomförda korrigeringar"
        description="Samtliga rättelser sedan lanseringen."
      />
      {
        corrections.length > 0 ? (
          <div class="mt-6 overflow-x-auto">
            <table class="w-full min-w-[36rem] border-collapse text-sm">
              <caption class="sr-only">Logg över korrigeringar</caption>
              <thead>
                <tr class="border-b border-border text-left">
                  <th scope="col" class="py-2 pr-4 font-medium">Datum</th>
                  <th scope="col" class="py-2 pr-4 font-medium">Sida</th>
                  <th scope="col" class="py-2 pr-4 font-medium">Beskrivning</th>
                  <th scope="col" class="py-2 pr-4 font-medium">Status</th>
                  <th scope="col" class="py-2 font-medium">Åtgärd</th>
                </tr>
              </thead>
              <tbody>
                {corrections.map((c) => (
                  <tr class="border-b border-border align-top">
                    <td class="py-2.5 pr-4 whitespace-nowrap bi-mono !text-[10px]">
                      {formatDate(c.data.submittedAt)}
                    </td>
                    <td class="py-2.5 pr-4">{c.data.pageUrl}</td>
                    <td class="py-2.5 pr-4 text-muted-foreground">{c.data.description}</td>
                    <td class="py-2.5 pr-4">{statusLabels[c.data.status]}</td>
                    <td class="py-2.5 text-muted-foreground">{c.data.resolution ?? "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="mt-4 max-w-2xl border border-dashed border-border p-4 text-sm text-muted-foreground">
            Inga korrigeringar har gjorts ännu. När den första rättelsen görs
            redovisas den här.
          </p>
        )
      }
    </section>
  </div>
</BaseLayout>
