---
import BaseLayout from "@/layouts/BaseLayout.astro";
import QuestionTeaser from "@/components/QuestionTeaser.astro";
import { getCollection } from "astro:content";

const questions = (await getCollection("questions")).sort(
  (a, b) => a.data.displayOrder - b.data.displayOrder,
);
---

<BaseLayout
  title="Vanliga frågor"
  description="Vad säger partierna om AI och jobben, skolan, vården, övervakning, datacenter och klimatet? Här samlar vi svaren."
>
  <div class="mx-auto max-w-7xl px-6" data-pagefind-body>
    <header class="border-b border-border py-10">
      <div class="bi-mono">Ingångar för väljare</div>
      <h1 class="mt-3 text-3xl md:text-4xl leading-tight">Börja med en fråga</h1>
      <p class="mt-3 max-w-2xl text-base text-muted-foreground">
        Vanliga frågor inför valet. Svaren bygger på de källor vi har gått igenom,
        inte på gissningar. När vi saknar ett tydligt svar skriver vi det.
      </p>
    </header>
    <div class="my-10 grid gap-4 sm:grid-cols-2" data-pagefind-ignore>
      {questions.map((q) => <QuestionTeaser question={q} />)}
    </div>
  </div>
</BaseLayout>
