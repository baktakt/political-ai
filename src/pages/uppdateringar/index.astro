---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getMeta } from "@/lib/content";
import { formatDate } from "@/lib/format";

const meta = await getMeta();
const updates = (await getCollection("updates")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);
const typeLabels: Record<string, string> = {
  lansering: "Lansering",
  innehall: "Innehåll",
  metod: "Metod",
  korrigering: "Korrigering",
  teknik: "Teknik",
};
---

<BaseLayout
  title="Uppdateringar"
  description="Versionshistorik och uppdateringslogg: vad som ändrats i research, metod och innehåll, och när."
>
  <div class="mx-auto max-w-7xl px-6" data-pagefind-body>
    <header class="border-b border-border py-10">
      <div class="bi-mono">
        Datamängd v{meta.datasetVersion} · uppdaterad {formatDate(meta.lastUpdated)}
      </div>
      <h1 class="mt-3 text-3xl md:text-4xl leading-tight">Uppdateringar</h1>
      <p class="mt-3 max-w-2xl text-base text-muted-foreground">
        Alla ändringar i innehåll, research och metod loggas här. Du kan även
        prenumerera via <a href="/rss.xml" class="border-b border-border pb-px hover:text-foreground">RSS</a>.
        Rättelser redovisas dessutom på <a href="/korrigeringar/" class="border-b border-border pb-px hover:text-foreground">korrigeringssidan</a>.
      </p>
    </header>

    <ol class="my-10 max-w-3xl border-l border-border">
      {
        updates.map((update) => (
          <li class="relative pl-6 pb-8 last:pb-0">
            <span class="absolute -left-[3.5px] top-1.5 h-1.5 w-1.5 bg-foreground" aria-hidden="true" />
            <div class="bi-mono">
              {formatDate(update.data.date)} · {typeLabels[update.data.type]}
            </div>
            <h2 class="mt-1 font-display text-lg leading-snug">{update.data.title}</h2>
            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{update.data.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>
