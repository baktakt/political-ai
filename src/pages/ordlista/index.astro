---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const entries = (await getCollection("glossary")).sort((a, b) =>
  new Intl.Collator("sv").compare(a.data.term, b.data.term),
);
---

<BaseLayout
  title="Ordlista"
  description="Svåra AI- och riksdagsbegrepp förklarade på enkel svenska: från algoritm och deepfake till partimotion och rekyleffekt."
>
  <div class="mx-auto max-w-7xl px-6" data-pagefind-body data-pagefind-filter="Typ:Ordlista">
    <header class="border-b border-border py-10">
      <div class="bi-mono">Klarspråk · {entries.length} begrepp</div>
      <h1 class="mt-3 text-3xl md:text-4xl leading-tight">Ordlista</h1>
      <p class="mt-3 max-w-2xl text-base text-muted-foreground">
        Tekniska och parlamentariska begrepp, förklarade utan fackspråk. Begrepp
        i löptexten länkar hit.
      </p>
    </header>

    <dl class="my-10 max-w-3xl divide-y divide-border border-t border-b border-border">
      {
        entries.map((entry) => (
          <div class="py-5" id={entry.id}>
            <dt class="font-display text-lg">{entry.data.term}</dt>
            <dd class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
              {entry.data.definition}
              {entry.data.example && (
                <span class="mt-2 block border-l-2 border-border pl-3 text-xs">
                  Exempel: {entry.data.example}
                </span>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</BaseLayout>
