---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PartyCard from "@/components/PartyCard.astro";
import NeutralityNote from "@/components/NeutralityNote.astro";
import {
  getPartiesSorted,
  getTopicsSorted,
  getSourcesMap,
} from "@/lib/content";
import { getPartyPresentation } from "@/lib/party-presentation";
import { formatDate } from "@/lib/format";

const parties = await getPartiesSorted();
const topics = await getTopicsSorted();
const sourcesMap = await getSourcesMap();
const allPositionRecords = (await import("@/data/positions.json")).default;
const presentations = new Map(
  parties.map((party) => [
    party.id,
    getPartyPresentation(party.data, allPositionRecords),
  ]),
);
const documentedParties = parties.filter(
  (party) => presentations.get(party.id)?.informationLevel === "dokumenterad_inriktning",
);
const limitedParties = parties.filter(
  (party) => presentations.get(party.id)?.informationLevel === "begransat_underlag",
);
const fullyPublishedParties = parties.filter(
  (party) => presentations.get(party.id)?.publishedTopicCount === topics.length,
);
const listFormatter = new Intl.ListFormat("sv", { style: "long", type: "conjunction" });
const documentedPartyNames = listFormatter.format(documentedParties.map((party) => party.data.name));
const limitedPartyNames = listFormatter.format(limitedParties.map((party) => party.data.name));
const fullyPublishedPartyNames = listFormatter.format(fullyPublishedParties.map((party) => party.data.name));
const verifiedAt = parties[0]?.data.verifiedAt;
const verificationSources = [
  ...new Set(parties.flatMap((p) => p.data.verificationSourceIds)),
]
  .map((id) => sourcesMap.get(id))
  .filter((s) => s != null);
---

<BaseLayout
  title="Partiernas syn på AI"
  description="En enkel, källbaserad överblick över riksdagspartiernas syn på AI och de frågor där vi ännu vet för lite."
>
  <div class="mx-auto max-w-7xl px-6" data-pagefind-body>
    <header class="border-b border-border py-10 md:py-14">
      <div class="bi-mono">Inför riksdagsvalet 2026</div>
      <h1 class="mt-3 max-w-3xl text-3xl leading-tight md:text-5xl">
        Hur närmar sig partierna AI?
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-muted-foreground md:text-lg">
        Överblicken utgår från vad partierna har sagt och föreslagit. Den
        markerar när vi vet för lite för en rättvisande slutsats, och
        rankar inte partiernas AI-politik.
      </p>
    </header>

    <section class="grid gap-5 border-b border-border py-8 lg:grid-cols-[1.25fr_1fr]">
      <div class="border border-border bg-card p-6">
        <div class="bi-mono !text-[10px]">Det korta svaret</div>
        <h2 class="mt-2 text-2xl leading-snug">För flera partier går det att beskriva synen på AI</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          Vi har tillräckligt med material för att beskriva hur
          {" "}<strong class="font-medium text-foreground">{documentedPartyNames}</strong>.
          ser på AI. Det betyder inte att de har en egen, heltäckande AI-strategi eller svar på alla frågor.
        </p>
        {
          fullyPublishedParties.length > 0 && (
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
              <strong class="font-medium text-foreground">{fullyPublishedPartyNames}</strong>{" "}
              {fullyPublishedParties.length === 1 ? "är det parti vi" : "är de partier vi"} hittills har gått igenom
              i alla våra {topics.length} AI-frågor. Det visar hur mycket
              material vi har hunnit gå igenom, inte kvaliteten på partiets politik.
            </p>
          )
        }
      </div>

      <aside class="border border-dashed border-border p-6">
        <div class="bi-mono !text-[10px]">Där vi vet mindre</div>
        <h2 class="mt-2 text-xl leading-snug">För lite underlag ännu för {limitedParties.length} partier</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          För <strong class="font-medium text-foreground">{limitedPartyNames}</strong>{" "}
          har vi ännu inte tillräckligt med publicerat material för en rättvis bild. Enstaka
          uppgifter kan finnas, men regeringspolitik eller en ledamots uttalande räknas inte
          automatiskt som partiets egen linje.
        </p>
      </aside>
    </section>

    <section class="py-8" aria-labelledby="alla-partier">
      <div class="max-w-3xl">
        <div class="bi-mono !text-[10px]">Alla riksdagspartier</div>
        <h2 id="alla-partier" class="mt-2 text-2xl md:text-3xl">Parti för parti</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Partierna står i bokstavsordning. Varje kort visar både hur partiet ser på AI och
          hur många frågor vi har hunnit gå igenom.
        </p>
      </div>

      <div class="mt-6 grid gap-4 md:grid-cols-2" data-pagefind-ignore>
        {
          parties.map((party) => (
            <PartyCard party={party} presentation={presentations.get(party.id)!} />
          ))
        }
      </div>
    </section>

    <div class="max-w-3xl pb-2">
      <NeutralityNote />
    </div>

    <section class="mt-8 mb-16 border-t border-border pt-6">
      <h2 class="bi-mono !text-[11px]">Så kollade vi partiuppgifterna</h2>
      <p class="mt-2 max-w-3xl text-sm text-muted-foreground">
        Vi har jämfört listan över riksdagspartier, mandat och regeringsställning
        {verifiedAt && ` ${formatDate(verifiedAt)}`} med officiella källor. Nio ledamöter sitter under valperioden utan
        partibeteckning; de redovisas inte som parti.
      </p>
      <ul class="mt-3 space-y-1 text-sm">
        {
          verificationSources.map((s) => (
            <li>
              <a
                href={`/kallor/#kalla-${s.id}`}
                class="border-b border-border pb-px text-muted-foreground hover:text-foreground"
              >
                {s.data.title} — {s.data.publisher}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
