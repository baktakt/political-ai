---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PartyMark from "@/components/PartyMark.astro";
import PositionBlock from "@/components/PositionBlock.astro";
import Timeline from "@/components/Timeline.astro";
import SourceItem from "@/components/SourceItem.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import {
  getPartiesSorted,
  getTopicsSorted,
  getPositionsByParty,
  getPublishedProposals,
  getPublishedActions,
  getSourcesMap,
  getTimelineForParty,
} from "@/lib/content";
import {
  ACTION_TYPE_LABELS,
  GOVERNMENT_STATUS_LABELS,
  PROPOSAL_STATUS_LABELS,
} from "@/lib/evidence";
import { formatDate } from "@/lib/format";

import allPositionRecords from "@/data/positions.json";

export async function getStaticPaths() {
  const parties = await getPartiesSorted();
  return parties.map((party) => ({ params: { id: party.id }, props: { party } }));
}

const { party } = Astro.props;
const p = party.data;

const topics = await getTopicsSorted();
const positions = await getPositionsByParty(party.id);
const proposals = (await getPublishedProposals()).filter(
  (x) => x.data.partyId === party.id,
);
const actions = (await getPublishedActions()).filter(
  (x) => x.data.partyId === party.id,
);
const timeline = await getTimelineForParty(party.id);
const sourcesMap = await getSourcesMap();

const positionByTopic = new Map(positions.map((pos) => [pos.data.topicId, pos]));
const documentedTopics = topics.filter((topic) => positionByTopic.has(topic.id));


const noPositionTopics = topics.filter(
  (t) => positionByTopic.get(t.id)?.data.evidenceStatus === "ingen_dokumenterad",
);
const notPublishedTopics = topics.filter((t) => !positionByTopic.has(t.id));

const partyOverviewSourceIds = allPositionRecords
  .filter((position) => position.partyId === party.id)
  .flatMap((position) => position.sourceIds);
const referencedSourceIds = new Set<string>([
  ...partyOverviewSourceIds,
  ...positions.flatMap((x) => x.data.sourceIds),
  ...proposals.flatMap((x) => x.data.sourceIds),
  ...actions.flatMap((x) => x.data.sourceIds),
  ...timeline.flatMap((x) => x.data.sourceIds),
]);
const referencedSources = [...referencedSourceIds]
  .map((id) => sourcesMap.get(id))
  .filter((s) => s != null)
  .sort((a, b) => (b.data.publicationDate ?? "").localeCompare(a.data.publicationDate ?? ""));

const sourcesFor = (ids: string[]) =>
  ids.map((id) => sourcesMap.get(id)).filter((s) => s != null);

const isGovernmentSide = p.governmentStatus !== "opposition";
const correctionUrl = `/korrigeringar/?sida=${encodeURIComponent(`/partier/${party.id}/`)}`;
---

<BaseLayout
  title={`${p.name} om AI`}
  description={p.aiSummary ?? `${p.name}: dokumenterad syn på AI, förslag, riksdagsaktivitet och källor.`}
>
  <div class="mx-auto max-w-7xl px-6" data-pagefind-body data-pagefind-filter={`Parti:${p.abbreviation}`}>
    <header class="border-b border-border py-10">
      <nav aria-label="Brödsmulor" class="bi-mono flex flex-wrap items-center gap-2">
        <a href="/partier/" class="hover:text-foreground">Partierna</a>
        <span aria-hidden="true">/</span>
        <span class="text-foreground">{p.name}</span>
      </nav>
      <div class="mt-5 flex flex-wrap items-start justify-between gap-6">
        <div class="max-w-2xl">
          <h1 class="text-3xl md:text-4xl leading-tight">{p.name}</h1>
          <p class="mt-3 text-base text-muted-foreground">{p.summary}</p>
          {p.governmentNote && <p class="mt-2 text-sm text-muted-foreground">{p.governmentNote}</p>}
        </div>
        <div class="border border-border bg-card p-4 text-sm">
          <PartyMark abbreviation={p.abbreviation} color={p.color} size="md" />
          <dl class="mt-3 space-y-1.5 text-xs text-muted-foreground">
            <div class="flex gap-2">
              <dt class="font-medium text-foreground">Status:</dt>
              <dd>{GOVERNMENT_STATUS_LABELS[p.governmentStatus]}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="font-medium text-foreground">Mandat 2022:</dt>
              <dd>{p.seats2022}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="font-medium text-foreground">Ledamöter nu:</dt>
              <dd>{p.currentSeats}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="font-medium text-foreground">Verifierad:</dt>
              <dd>{formatDate(p.verifiedAt)}</dd>
            </div>
          </dl>
          <a
            href={p.officialUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-block border-b border-foreground pb-0.5 text-xs hover:opacity-70"
            >Partiets webbplats</a
          >
        </div>
      </div>
      <div class="mt-6 bi-mono">
        {
          p.lastReviewedAt
            ? `Senast genomgången ${formatDate(p.lastReviewedAt)}`
            : "Vi har ännu inte gått igenom partiets AI-politik. Här visas bara grunduppgifter."
        }
      </div>
    </header>

    <!-- Short, plain-language overview. Details live in the sections below. -->
    <section class="max-w-3xl py-8 md:py-10">
      {
        p.aiSummary ? (
          <p class="text-base leading-8 md:text-lg md:leading-8">{p.aiSummary}</p>
        ) : <p class="text-base leading-8 text-muted-foreground md:text-lg md:leading-8">Här samlar vi material om partiets AI-politik, förslag och källor.</p>
      }

      {
        p.sustainabilityPriorities.length > 0 && (
          <ul class="mt-5 space-y-2 border-t border-border pt-4 text-sm leading-relaxed text-muted-foreground">
            {p.sustainabilityPriorities.map((priority) => (
              <li class="flex gap-2">
                <span aria-hidden="true">·</span>
                <span>{priority}</span>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <!-- Publicerade sakfrågor -->
    {
      documentedTopics.length > 0 ? (
        <section class="py-10">
          <SectionLabel
            title="Fråga för fråga"
            description="Öppna en fråga för att se vad partiet har sagt och vilka källor vi har använt."
          />
          <div class="mt-6 space-y-4">
            {documentedTopics.map((topic) => {
              const position = positionByTopic.get(topic.id)!;
              return (
                <PositionBlock
                  position={position}
                  heading={{ label: topic.data.title, href: `/amnen/${topic.id}/` }}
                  sources={sourcesFor(position.data.sourceIds)}
                />
              );
            })}
          </div>
        </section>
      ) : (
        <section class="py-8">
          <div class="border border-dashed border-border p-6">
            <div class="bi-mono !text-[10px]">Sakfrågor</div>
            <h2 class="mt-2 text-xl">Ingen ämnesvis fördjupning publicerad ännu</h2>
            <p class="mt-2 max-w-3xl text-sm leading-relaxed text-muted-foreground">
              Det kan finnas granskat material i redaktionens arbetsflöde, men vi visar inte
              en sakfråga här förrän den är färdig för publicering. Den övergripande
              sammanfattningen ovan bygger på det underlag som har granskats för partiet.
            </p>
          </div>
        </section>
      )
    }

    <!-- Konkreta förslag -->
    {
      proposals.length > 0 && (
        <section class="py-10">
          <SectionLabel
            title="Förslag"
            description="Här finns de förslag från partiet som vi har hittat."
          />
          <div class="mt-6 space-y-4">
            {proposals.map((proposal) => (
              <article class="border border-border bg-card p-5">
                <div class="flex flex-wrap items-center gap-3 text-xs text-muted-foreground">
                  <span class="bi-mono">{formatDate(proposal.data.date)}</span>
                  <span class="border border-border px-1.5 py-px uppercase tracking-wide text-[10px]">
                    {PROPOSAL_STATUS_LABELS[proposal.data.status]}
                  </span>
                </div>
                <h3 class="mt-2 font-display text-lg leading-snug">{proposal.data.title}</h3>
                <p class="mt-2 text-sm text-muted-foreground">{proposal.data.description}</p>
                {proposal.data.implementationStatus && (
                  <p class="mt-2 text-xs text-muted-foreground">
                    <span class="font-medium text-foreground">Genomförande:</span>{" "}
                    {proposal.data.implementationStatus}
                  </p>
                )}
                <details class="mt-3">
                  <summary class="cursor-pointer text-xs text-muted-foreground hover:text-foreground">
                    Källor ({proposal.data.sourceIds.length})
                  </summary>
                  <div class="mt-3 space-y-3">
                    {sourcesFor(proposal.data.sourceIds).map((s) => (
                      <SourceItem source={s} />
                    ))}
                  </div>
                </details>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <!-- Riksdagsaktivitet -->
    {
      actions.length > 0 && (
        <section class="py-10">
          <SectionLabel
            title="I riksdagen"
            description="Motioner, frågor och voteringar. En partimotion kommer från partiet eller riksdagsgruppen. En enskild motion visar en ledamots eget initiativ."
          />
          <div class="mt-6 overflow-x-auto">
            <table class="w-full min-w-[42rem] border-collapse text-sm">
              <caption class="sr-only">Riksdagsaktivitet för {p.name}</caption>
              <thead>
                <tr class="border-b border-border text-left">
                  <th scope="col" class="py-2 pr-4 font-medium">Datum</th>
                  <th scope="col" class="py-2 pr-4 font-medium">Typ</th>
                  <th scope="col" class="py-2 pr-4 font-medium">Titel</th>
                  <th scope="col" class="py-2 pr-4 font-medium">Nivå</th>
                  <th scope="col" class="py-2 font-medium">Resultat</th>
                </tr>
              </thead>
              <tbody>
                {actions.map((action) => (
                  <tr class="border-b border-border align-top">
                    <td class="py-2.5 pr-4 whitespace-nowrap bi-mono !text-[10px]">
                      {formatDate(action.data.date)}
                    </td>
                    <td class="py-2.5 pr-4">{ACTION_TYPE_LABELS[action.data.actionType]}</td>
                    <td class="py-2.5 pr-4">
                      {action.data.title}
                      {action.data.documentNumber && (
                        <span class="block bi-mono !text-[10px] mt-0.5">{action.data.documentNumber}</span>
                      )}
                    </td>
                    <td class="py-2.5 pr-4">{action.data.partyLevel ? "Partinivå" : "Enskild"}</td>
                    <td class="py-2.5 text-muted-foreground">{action.data.result ?? "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    <!-- Regeringsroll -->
    {
      isGovernmentSide && (
        <section class="py-10">
          <SectionLabel title="Parti, regering och Tidöavtalet" />
          <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted-foreground">
            {p.name} {p.governmentStatus === "regering" ? "ingår i regeringen" : "är samarbetsparti till regeringen"}
            under valperioden 2022–2026. Regeringsbeslut kan bygga på kompromisser
            mellan flera partier och redovisas därför separat från partiets egen
            politik och märks därför som sådant. Att regeringen gjort något betyder inte
            automatiskt att det är {p.abbreviation}:s egen linje. Läs mer på <a href="/metod/" class="border-b border-border pb-px hover:text-foreground">metodsidan</a>.
          </p>
        </section>
      )
    }

    <!-- Tidslinje -->
    {
      timeline.length > 0 && (
        <section class="py-10">
          <SectionLabel title="Tidslinje" />
          <div class="mt-6 max-w-3xl">
            <Timeline events={timeline} />
          </div>
        </section>
      )
    }

    <!-- Vad vi ännu inte vet -->
    <section class="py-10">
      <SectionLabel
        title="Frågor där vi ännu saknar svar"
        description="När vi inte visar något besked betyder det inte att partiet är för eller emot."
      />
      <div class="mt-6 border border-dashed border-border p-6">
        {
          notPublishedTopics.length > 0 ? (
            <p class="max-w-3xl text-sm leading-relaxed text-muted-foreground">
              För {notPublishedTopics.length} av våra {topics.length} frågor har vi ännu inget
              svar för {p.name}. Material kan saknas, vara under genomgång eller vara för otydligt
              för att vi ska kunna säga något säkert.
            </p>
          ) : (
            <p class="max-w-3xl text-sm leading-relaxed text-muted-foreground">
              Vi har gått igenom alla våra {topics.length} frågor för {p.name}. Det betyder inte
              att partiet har gett ett tydligt besked i varje fråga.
            </p>
          )
        }
        {
          noPositionTopics.length > 0 && (
            <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted-foreground">
              I {noPositionTopics.length} {noPositionTopics.length === 1 ? "fråga" : "frågor"}
              hittade vi inget tydligt besked. Det står i respektive fördjupning.
            </p>
          )
        }
        {
          notPublishedTopics.length > 0 && (
            <details class="mt-4">
              <summary class="cursor-pointer text-sm font-medium">Visa frågor vi inte har gått igenom ännu</summary>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                {notPublishedTopics.map((topic) => topic.data.shortTitle).join(" · ")}
              </p>
            </details>
          )
        }
      </div>
    </section>

    <!-- Källförteckning -->
    <section class="py-10">
      <SectionLabel
        title={`Källor (${referencedSources.length})`}
        description="Alla källor vi har använt på den här sidan."
      />
      {
        referencedSources.length > 0 ? (
          <details class="mt-6 border border-border bg-card p-5">
            <summary class="cursor-pointer text-sm font-medium">
              Visa alla {referencedSources.length} {referencedSources.length === 1 ? "källa" : "källor"}
            </summary>
            <div class="mt-5 space-y-3">
              {referencedSources.map((s) => (
                <SourceItem source={s} headingLevel="h3" />
              ))}
            </div>
          </details>
        ) : (
          <p class="mt-4 text-sm text-muted-foreground">
            Inga researchkällor ännu — endast partiets grunduppgifter är verifierade
            (se <a href="/partier/" class="border-b border-border pb-px">partiöversikten</a>).
          </p>
        )
      }
    </section>

    <footer class="mb-16 border-t border-border pt-6 flex flex-wrap items-center justify-between gap-3">
      <span class="bi-mono">
        {
          p.lastReviewedAt
            ? `Senast genomgången ${formatDate(p.lastReviewedAt)}`
            : "Inte genomgången ännu"
        }
      </span>
      <a
        href={correctionUrl}
        class="border border-border px-3 py-1.5 text-xs uppercase tracking-wide text-muted-foreground hover:border-foreground hover:text-foreground transition-colors"
        >Hittat ett fel? Föreslå korrigering</a
      >
    </footer>
  </div>
</BaseLayout>
