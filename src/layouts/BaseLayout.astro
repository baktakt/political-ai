---
import "../styles/global.css";
import SiteHeader from "@/components/SiteHeader";
import SiteFooter from "@/components/SiteFooter";
import {
  SITE,
  NAV_ITEMS,
  FOOTER_BROWSE_LINKS,
  FOOTER_SYSTEM_LINKS,
} from "@/data/site";
import { pageTitle, truncateDescription, type SeoProps } from "@/lib/seo";
import { getMeta } from "@/lib/content";
import { formatDate } from "@/lib/format";

interface Props extends SeoProps {}

const {
  title,
  description,
  type = "website",
  image = "/og-image.jpg",
  imageAlt = "Sveriges AI-politik: detta vill partierna",
  publishedAt,
} = Astro.props;
const meta = await getMeta();
const fullTitle = pageTitle(title);
const metaDescription = truncateDescription(description);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} — uppdateringar`}
      href={new URL("/rss.xml", Astro.site)}
    />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="672" />
    <meta property="og:image:alt" content={imageAlt} />
    {
      type === "article" && publishedAt && (
        <meta property="article:published_time" content={publishedAt} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground">
    <a href="#huvudinnehall" class="skip-link">Hoppa till innehållet</a>
    <SiteHeader
      nav={NAV_ITEMS}
      brandHref="/"
      brandTitle={SITE.name}
      brandSubtitle={SITE.brandSubtitle}
      ctaHref="/partier/"
      ctaLabel="Se partierna"
      currentPath={Astro.url.pathname}
    />
    <main id="huvudinnehall" class="flex-1">
      <slot />
    </main>
    <SiteFooter
      brandTitle={SITE.name}
      brandDescription={`${SITE.description} ${SITE.neutralityStatement}`}
      browseLinks={FOOTER_BROWSE_LINKS}
      systemLinks={FOOTER_SYSTEM_LINKS}
      issueLabel={`© 2026 ${SITE.name} · Partipolitiskt neutral`}
      versionLabel={`Senast genomgången ${formatDate(meta.researchLastUpdated)}`}
    />
  </body>
</html>
